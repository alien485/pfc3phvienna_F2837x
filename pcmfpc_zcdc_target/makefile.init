# CCS can schedule an implicit clean after importing an existing output tree.
# Stop before any removal recipe; the workspace forbids bulk file deletion.
ifneq ($(strip $(filter clean rebuild CLEAN_DISABLED_BY_POLICY,$(MAKECMDGOALS))),)
$(error Bulk cleanup is disabled by workspace policy. Use incremental all; ask the user to handle any required cleanup manually)
endif

# These recursive override values also block removal from other generated
# targets. Ordinary compilation and linking do not need these commands.
override RM = $(error File removal is disabled by workspace policy)
override RMDIR = $(error Directory removal is disabled by workspace policy)

# SysConfig generates the settings header alongside the solution sources.
.DEFAULT_GOAL := all
override GEN_MISC_FILES := \
../vienna_settings.h \
./syscfg/Kit.json \
./syscfg/board.h \
./syscfg/board.cmd.genlibs \
./syscfg/board.json \
./syscfg/pinmux.csv \
./syscfg/c2000ware_libraries.cmd.genlibs \
./syscfg/c2000ware_libraries.h \
./syscfg/clocktree.h
../vienna_settings.h: syscfg/board.opt
vienna.obj vienna_hal.obj vienna_main.obj vienna_clatask.obj: ../vienna_settings.h ../vienna_user_settings.h ../vienna.h ../vienna_hal.h ../vienna_fcs_mpc.h

# New fixed-size controller headers are real build dependencies.
vienna.obj vienna_main.obj vienna_pcmfpc_runtime.obj vienna_pcmfpc_zcdc.obj vienna_pcmfpc_observer.obj vienna_pcmfpc_fast.obj: ../vienna_pcmfpc_runtime.h ../vienna_pcmfpc_zcdc.h ../vienna_pcmfpc_observer.h ../vienna_grid_sync.h ../vienna_pcmfpc_fast.h
